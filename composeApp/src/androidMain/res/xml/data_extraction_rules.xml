<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Android back up lesson progress, settings and imported MIDI files (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
