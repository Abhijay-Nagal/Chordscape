<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Keyscape</string>

    <!-- Cream of the Keyscape logo, so the system splash blends into the in-app logo screen. -->
    <color name="splash_bg">#FFFCF4E5</color>
    <color name="ic_launcher_background">#FFFCF4E5</color>

    <style name="Theme.Keyscape" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
